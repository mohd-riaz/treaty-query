{
  "name": "treaty-query",
  "version": "0.1.0",
  "description": "Type-safe TanStack Query bindings for Elysia Treaty clients.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/compatibility.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun node_modules/tsdown/dist/run.mjs",
    "check-types": "bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && bun node_modules/typescript/bin/tsc --noEmit -p tests/tsconfig.json",
    "test": "bun test",
    "pack": "bun pm pack",
    "audit:package": "bun run build && bun pm pack && bun run scripts/audit-package.ts",
    "prepublishOnly": "bun run check-types && bun test && bun run build"
  },
  "peerDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@tanstack/react-query": "^5.101.4",
    "elysia": ">=1.4.19 <2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@elysiajs/eden": "1.4.9",
    "@happy-dom/global-registrator": "20.11.2",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "elysia": "1.4.29",
    "happy-dom": "20.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "elysia",
    "treaty",
    "tanstack-query",
    "react-query",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohd-riaz/treaty-query.git"
  },
  "bugs": {
    "url": "https://github.com/mohd-riaz/treaty-query/issues"
  },
  "homepage": "https://github.com/mohd-riaz/treaty-query#readme"
}
